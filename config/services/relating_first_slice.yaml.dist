# Relating first working slice wiring.
#
# Import only after the extracted skeleton has passed package validation.
# This file wires concrete infrastructure for the first runnable business slice.
#
# Boundary:
# - no CRUD routes;
# - no CRUD controllers;
# - no CRUD YAML;
# - no migrations;
# - no direct SQL;
# - no Bundle layer.

services:
    App\Relating\Repository\RelationDoctrineRelationshipRepository:
        arguments:
            $entityManager: '@doctrine.orm.entity_manager'

    App\Relating\Repository\RelationDoctrineLeadRepository:
        arguments:
            $entityManager: '@doctrine.orm.entity_manager'

    App\Relating\Repository\RelationDoctrineOpportunityRepository:
        arguments:
            $entityManager: '@doctrine.orm.entity_manager'

    App\Relating\Service\RelationUuidRelatingIdGenerator: ~

    App\Relating\Service\RelationDispatchingRelatingBusinessEventDispatcher:
        arguments:
            $eventDispatcher: '@event_dispatcher'

    App\Relating\Service\RelationVendorLeadReadService:
        arguments:
            $relationships: '@App\Relating\Repository\RelationshipRepositoryInterface'
            $leads: '@App\Relating\Repository\RelationLeadRepositoryInterface'

    App\Relating\Repository\RelationshipRepositoryInterface:
        alias: App\Relating\Repository\RelationDoctrineRelationshipRepository

    App\Relating\Repository\RelationLeadRepositoryInterface:
        alias: App\Relating\Repository\RelationDoctrineLeadRepository

    App\Relating\Repository\RelationOpportunityRepositoryInterface:
        alias: App\Relating\Repository\RelationDoctrineOpportunityRepository

    App\Relating\Service\RelationRelatingIdGeneratorInterface:
        alias: App\Relating\Service\RelationUuidRelatingIdGenerator

    App\Relating\Service\RelationRelatingBusinessEventRecorderInterface:
        alias: App\Relating\Service\RelationDispatchingRelatingBusinessEventDispatcher

    App\Relating\Service\RelationVendorLeadReadServiceInterface:
        alias: App\Relating\Service\RelationVendorLeadReadService
