# Relating Messenger routing draft.
#
# Copy or import intentionally after the application defines the `async` transport.
# This file is .dist on purpose. It must not force message routing before host app policy is ready.
#
# Boundary:
# - business messages only;
# - no Created/Updated/Deleted CRUD entity messages;
# - no generic persistence messages;
# - handlers must call business application services or projectors.

framework:
    messenger:
        routing:
            App\Relating\Message\RelationQualifyLeadMessage: async
            App\Relating\Message\RelationConvertLeadMessage: async
            App\Relating\Message\RelationTransitionOpportunityStageMessage: async
            App\Relating\Message\RelationDetectLeadDuplicateMessage: async
            App\Relating\Message\RelationScoreLeadMessage: async
            App\Relating\Message\RelationBuildRelationshipTimelineMessage: async
            App\Relating\Message\RelationBuildTimelineMessage: async
            App\Relating\Message\RelationRecalculateRelationshipHealthMessage: async
            App\Relating\Message\RelationRecalculateOpportunityForecastMessage: async
            App\Relating\Message\RelationRecalculateOpportunityRiskMessage: async
            App\Relating\Message\RelationRecalculateCaseSlaMessage: async
            App\Relating\Message\RelationCaptureCampaignResponseMessage: async
            App\Relating\Message\RelationRebuildCampaignPerformanceMessage: async
            App\Relating\Message\RelationRunRelatingAutomationMessage: async
            App\Relating\Message\RelationRaiseAiSuggestionMessage: async
            App\Relating\Message\RelationReviewAiSuggestionMessage: async
            App\Relating\Message\RelationApplyAiSuggestionMessage: async
