{
  "name": "smartresponsor/relating",
  "description": "SmartResponsor Relating CRM relationship lifecycle component.",
  "type": "symfony-bundle",
  "license": "proprietary",
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require": {
    "php": ">=8.4 <8.5",
    "doctrine/orm": "^3.0",
    "symfony/console": "8.1.*",
    "symfony/framework-bundle": "8.1.*",
    "symfony/runtime": "8.1.*",
    "symfony/yaml": "8.1.*"
  },
  "require-dev": {
    "doctrine/doctrine-bundle": "^3.0",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit tests/Relating/RelatingSymfonyHttpSmokeTest.php"
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "8.1.*"
    }
  },
  "config": {
    "allow-plugins": {
      "symfony/runtime": true
    }
  }
}
