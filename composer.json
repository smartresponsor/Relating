{
  "name": "relating/relation",
  "description": "SmartResponsor Relating CRM relationship lifecycle component.",
  "type": "symfony-bundle",
  "license": "proprietary",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "repositories": [
    {
      "type": "path",
      "url": "../Cruding",
      "options": {
        "symlink": true,
        "versions": {
          "cruding/crud": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Collectioning",
      "options": {
        "symlink": true,
        "versions": {
          "collectioning/collection": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Tabling",
      "options": {
        "symlink": true,
        "versions": {
          "tabling/table": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Viewing",
      "options": {
        "symlink": true,
        "versions": {
          "viewing/view": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Interfacing",
      "options": {
        "symlink": true,
        "versions": {
          "interfacing/interface": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Objecting",
      "options": {
        "symlink": true,
        "versions": {
          "objecting/object": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Gating",
      "options": {
        "symlink": true,
        "versions": {
          "gating/gate": "dev-master"
        }
      }
    }
  ],
  "require": {
    "php": ">=8.4 <8.5",
    "collectioning/collection": "dev-master",
    "cruding/crud": "dev-master",
    "doctrine/migrations": "^3.9",
    "doctrine/orm": "^3.0",
    "easycorp/easyadmin-bundle": "^5.0",
    "interfacing/interface": "dev-master",
    "objecting/object": "dev-master",
    "symfony/console": "8.1.*",
    "symfony/framework-bundle": "8.1.*",
    "symfony/runtime": "8.1.*",
    "symfony/yaml": "8.1.*",
    "tabling/table": "dev-master",
    "viewing/view": "dev-master"
  },
  "require-dev": {
    "doctrine/doctrine-bundle": "^3.0",
    "friendsofphp/php-cs-fixer": "^3.95",
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^12.0",
    "symfony/panther": "^2.4",
    "symfony/test-pack": "^1.2",
    "gating/gate": "dev-master"
  },
  "autoload": {
    "psr-4": {
      "App\\Relating\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Relating\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "cs:check": "php vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php --dry-run --diff",
    "cs:fix": "php vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php",
    "doctrine:schema:validate": "php tools/validate-doctrine-parity.php",
    "schema:parity": "php tools/validate-doctrine-parity.php",
    "gating:check": "php ../Gating/bin/gating check --target=. --policy-root=../Gating/.gating --severity-config=../Gating/.gating/config/severity.yaml",
    "phpstan": "phpstan analyse -c phpstan.neon --memory-limit=1G",
    "test": "phpunit tests",
    "test:coverage": [
      "@php -r \"if (!is_dir('var/coverage')) { mkdir('var/coverage', 0777, true); }\"",
      "@php -d xdebug.mode=coverage vendor/bin/phpunit --path-coverage --coverage-text=var/coverage/summary.txt"
    ],
    "gate": "@php vendor/bin/gating check --target=.",
    "quality": [
      "@cs:check",
      "@phpstan",
      "@test",
      "@gate"
    ]
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "8.1.*",
      "bundle": "App\\Relating\\RelatingBundle"
    }
  },
  "config": {
    "allow-plugins": {
      "symfony/runtime": true
    },
    "sort-packages": true
  }
}
